{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"sourceMap": false,

		// TypeScript 6.0 deprecates `moduleResolution: "node"` (node10) and `baseUrl`
		// (both removed in TS 7.0). Use the same `nodenext` pairing as the root tsconfig;
		// the package is CJS (`"type": "commonjs"`), so the emit stays CommonJS.
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"esModuleInterop": true,

		"isolatedModules": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"declaration": false,
		"noImplicitAny": false,
		"removeComments": true,
		"noLib": false,
		"strict": true,
		"strictFunctionTypes": false,
		"preserveConstEnums": true,
		"skipLibCheck": true,
		"outDir": "./out"
	},
	"exclude": ["node_modules", "typings/main", "typings/main.d.ts"]
}

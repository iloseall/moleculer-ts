{
	"compilerOptions": {
		"lib": ["ES2023"],
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "ES2022",

		// Keep ES2021 class field semantics (assignment instead of `Object.defineProperty`)
		// so the emitted runtime behaviour stays identical to the previous JS sources.
		"useDefineForClassFields": false,
		"esModuleInterop": false,

		// Type-only: lets the declaration output keep the `import type X from "./y"`
		// form used by the original hand-written .d.ts files. No runtime effect.
		"allowSyntheticDefaultImports": true,

		"strict": false,

		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noEmit": true
	},
	"include": ["types/extends.d.ts", "src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
